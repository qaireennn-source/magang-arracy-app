{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account information and role in MagiSMA",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["siswa", "admin"] },
        "avatarUrl": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "name", "role"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Comprehensive student profile, educational info, and CV metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 128 },
        "nisn": { "type": "string", "maxLength": 32 },
        "school": { "type": "string", "maxLength": 128 },
        "grade": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 32 },
        "interests": { "type": "array", "description": "List of student internship interests" },
        "bio": { "type": "string", "maxLength": 2048 },
        "cvFileName": { "type": "string", "maxLength": 256 },
        "cvFileSize": { "type": "string", "maxLength": 64 },
        "cvUploadDate": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "fullName", "school", "grade", "email"]
    },
    "InternshipProgram": {
      "title": "InternshipProgram",
      "description": "Internship program details offered by partner organizations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "companyName": { "type": "string", "maxLength": 128 },
        "companyLogo": { "type": "string", "maxLength": 64 },
        "sector": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 4096 },
        "responsibilities": { "type": "array" },
        "requirements": { "type": "array" },
        "location": { "type": "string", "maxLength": 256 },
        "city": { "type": "string", "maxLength": 128 },
        "workType": { "type": "string", "enum": ["Onsite", "Hybrid", "Remote"] },
        "period": { "type": "string", "maxLength": 128 },
        "duration": { "type": "string", "maxLength": 64 },
        "deadline": { "type": "string", "maxLength": 32 },
        "quota": { "type": "number" },
        "registeredCount": { "type": "number" },
        "status": { "type": "string", "enum": ["Buka", "Segera Ditutup", "Ditutup"] },
        "allowanceNotes": { "type": "string", "maxLength": 512 },
        "mentorName": { "type": "string", "maxLength": 128 },
        "contactEmail": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "title", "companyName", "sector", "workType", "quota", "status"]
    },
    "Application": {
      "title": "Application",
      "description": "Student internship submission and evaluation status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "programId": { "type": "string", "maxLength": 128 },
        "programTitle": { "type": "string", "maxLength": 256 },
        "companyName": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "studentSchool": { "type": "string", "maxLength": 128 },
        "studentGrade": { "type": "string", "maxLength": 64 },
        "studentNisn": { "type": "string", "maxLength": 32 },
        "studentEmail": { "type": "string", "maxLength": 256 },
        "studentPhone": { "type": "string", "maxLength": 32 },
        "motivation": { "type": "string", "maxLength": 4096 },
        "targetInterest": { "type": "string", "maxLength": 128 },
        "cvFileName": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["Menunggu Review", "Sedang Diproses", "Diterima", "Ditolak"] },
        "appliedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "adminNotes": { "type": "string", "maxLength": 2048 },
        "orientationDate": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "programId", "studentId", "status", "appliedAt"]
    },
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "Internship schedule milestone or student personal reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "applicationId": { "type": "string", "maxLength": 128 },
        "programTitle": { "type": "string", "maxLength": 256 },
        "companyName": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 64 },
        "location": { "type": "string", "maxLength": 256 },
        "type": { "type": "string", "enum": ["orientasi", "kegiatan", "mentoring", "tenggat_laporan", "catatan_pribadi"] },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["id", "studentId", "title", "date", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user accounts and roles"
    },
    "/student_profiles/{profileId}": {
      "schema": "StudentProfile",
      "description": "Student profiles and academic info"
    },
    "/programs/{programId}": {
      "schema": "InternshipProgram",
      "description": "Internship opportunities catalogue"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Applications submitted by students"
    },
    "/schedules/{scheduleId}": {
      "schema": "ScheduleItem",
      "description": "Student internship schedules and reminders"
    }
  }
}
